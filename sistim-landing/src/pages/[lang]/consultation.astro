---
// Free consultation: /ar/consultation/, /fr/consultation/, /en/consultation/
// Split screen: short 4-step form on the start side, artistic brand panel on the end side.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { siWhatsapp } from 'simple-icons';
import Base from '../../layouts/Base.astro';
import LangSwitcher from '../../components/LangSwitcher.astro';
import Icon from '../../components/Icon.astro';
import ConsultFlow from '../../components/islands/ConsultFlow';
import Logo3D from '../../components/consultation/Logo3D';
import { LOCALES, localePath, t, type Locale } from '../../i18n';
import { consultCopy } from '../../i18n/consult';
import { CONTACT, encodedEmail } from '../../config/contact';
import { DURATION_MINUTES, REPLY_TIME_HOURS, SHOW_THANKYOU_PHOTO, includesCall, includesRecommendation } from '../../config/consultation';

export const getStaticPaths = () => LOCALES.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params as { lang: Locale };
const d = t(lang);
const c = consultCopy(lang);
const home = localePath(lang);

// Thank-you photo: only when the flag is on AND ./brand/thankyou.jpg was processed by `npm run brand`
const photoSrc = SHOW_THANKYOU_PHOTO && existsSync(join(process.cwd(), 'public/brand/thankyou.webp')) ? '/brand/thankyou.webp' : undefined;
---
<Base locale={lang} page="consultation" title={d.brief.meta.title} description={d.brief.meta.description}>
  <ConsultFlow
    client:load
    locale={lang}
    s={d.brief}
    copy={{ cta: c.cta, title: c.title, lead: c.lead }}
    cfg={{ duration: DURATION_MINUTES, hours: REPLY_TIME_HOURS, includesCall, includesRecommendation }}
    wa={CONTACT.whatsappNumber}
    eml={encodedEmail()}
    handle={CONTACT.instagramHandle}
    homeHref={home}
    newTab={d.a11y.newTab}
    waIcon={siWhatsapp.path}
    photoSrc={photoSrc}
  >
    <!-- Hydrates after the form (client:idle vs client:load); Three.js is a lazy chunk inside it -->
    <Logo3D slot="logo" client:idle types={d.brief.types} />
    <header class="consult-header">
      <a href={home} class="flex items-center gap-2.5 rounded-full" aria-label={d.a11y.home}>
        <picture>
          <source srcset="/brand/mark.avif" type="image/avif" />
          <source srcset="/brand/mark.webp" type="image/webp" />
          <img src="/brand/mark.png" width="40" height="40" alt="" class="size-10" />
        </picture>
        <picture class="hidden min-[400px]:block">
          <source srcset="/brand/wordmark-swoosh-128.avif 1x, /brand/wordmark-swoosh-256.avif 2x" type="image/avif" />
          <source srcset="/brand/wordmark-swoosh-128.webp 1x, /brand/wordmark-swoosh-256.webp 2x" type="image/webp" />
          <img src="/brand/wordmark-swoosh-128.png" width="67" height="32" alt="" class="h-8 w-[67px]" />
        </picture>
      </a>
      <div class="flex items-center gap-2">
        <LangSwitcher locale={lang} page="consultation" />
        <a href={home} class="grid size-11 place-items-center rounded-full border border-white/12 text-white transition-colors hover:bg-white/5">
          <Icon name="close" size={20} />
          <span class="sr-only">{d.brief.ui.close}</span>
        </a>
      </div>
    </header>
  </ConsultFlow>
  <noscript>
    <p style="padding:2rem;text-align:center">
      <a class="btn btn-primary min-h-12 px-6" href={`https://wa.me/${CONTACT.whatsappNumber}`}>{d.contact.direct.whatsapp} · <span class="ltr">{CONTACT.phoneDisplay}</span></a>
    </p>
  </noscript>
</Base>

<script>
  import '../../scripts/common';
</script>
