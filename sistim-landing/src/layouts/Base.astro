---
import '../styles/global.css';
import { LOCALES, LOCALE_META, localePath, t, type Locale } from '../i18n';
import { SITE_URL, BRAND_NAME } from '../config/site';
import { CONTACT } from '../config/contact';

interface Props {
  locale: Locale;
  /** Page inside the locale ('' = landing, 'consultation' = brief). */
  page?: string;
  title?: string;
  description?: string;
  /** Landing page only: enables the motion gating class before first paint. */
  motion?: boolean;
  /** e.g. "noindex,follow" for pages that should stay out of search results. */
  robots?: string;
}
const { locale, page = '', title, description, motion = false, robots } = Astro.props;
const meta = LOCALE_META[locale];
const d = t(locale);
const pageTitle = title ?? d.meta.title;
const pageDescription = description ?? d.meta.description;
const canonical = `${SITE_URL}${localePath(locale, page)}`;
const ogImage = `${SITE_URL}/og/og-${locale}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: BRAND_NAME,
  alternateName: 'سيستيم',
  url: `${SITE_URL}/`,
  logo: `${SITE_URL}/icon-512.png`,
  description: d.meta.description,
  email: CONTACT.email,
  telephone: CONTACT.phoneIntl,
  sameAs: [CONTACT.instagramUrl, ...CONTACT.otherSocials],
  contactPoint: [{ '@type': 'ContactPoint', telephone: CONTACT.phoneIntl, contactType: 'customer service', availableLanguage: ['ar', 'fr', 'en'] }],
};

// Fonts to preload: Arabic pages need the Arabic + Latin subsets, FR/EN only Latin.
const preloads = locale === 'ar'
  ? ['/fonts/readex-pro-arabic-wght-normal.woff2', '/fonts/readex-pro-latin-wght-normal.woff2']
  : ['/fonts/readex-pro-latin-wght-normal.woff2'];
---
<!doctype html>
<html lang={meta.lang} dir={meta.dir} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={LOCALE_META[l].lang} href={`${SITE_URL}${localePath(l, page)}`} />)}
    {page === '' && <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />}

    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <meta name="theme-color" content="#232B3B" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.og} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].og} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {motion && (
      <script is:inline>
        (function () {
          var d = document.documentElement;
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            d.classList.add('motion');
            // Failsafe: if the motion script never boots, show everything.
            setTimeout(function () { if (!window.__sistimMotion) d.classList.remove('motion'); }, 3500);
          }
        })();
      </script>
    )}
  </head>
  <body class="bg-navy-900 text-white">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-[100] focus:rounded-full focus:bg-emerald-500 focus:px-5 focus:py-3 focus:text-navy-950">{d.a11y.skip}</a>
    <slot />
  </body>
</html>
