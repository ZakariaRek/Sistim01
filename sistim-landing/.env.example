# Free consultation form endpoint (Formspree or Web3Forms). Leave empty to skip sending:
# visitors then continue on WhatsApp / email from the thank-you screen.
# Formspree:  https://formspree.io/f/xxxxxxxx
# Web3Forms:  https://api.web3forms.com/submit
PUBLIC_CONSULTATION_ENDPOINT=

