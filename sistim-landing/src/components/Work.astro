---
// "Templates" section: a card per demo template. A click opens the full viewer page where the
// template can be scrolled (src/pages/[lang]/templates/[slug].astro).
import { t, localePath, type Locale } from '../i18n';
import { TEMPLATES, PREVIEW, templatePreview } from '../config/templates';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---
<section id="work" class="relative py-20 md:py-28" aria-labelledby="work-title">
  <div class="shell">
    <SectionHeader id="work-title" num="05" kicker={d.work.kicker} title={d.work.title} intro={d.work.intro} />
    <ul class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {TEMPLATES.map((tpl) => {
        const text = d.work.items[tpl.slug as keyof typeof d.work.items];
        return (
          <li data-reveal="item" class="min-w-0">
            <a href={localePath(locale, `templates/${tpl.slug}`)} class="tpl group block" data-tilt>
              <div class="tpl-frame card" dir="ltr">
                <div class="flex items-center gap-1.5 border-b border-white/8 px-4 py-3" aria-hidden="true">
                  <span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span>
                  <span class="ms-3 h-5 flex-1 rounded-full bg-white/6"></span>
                </div>
                <div class="tpl-view">
                  <img
                    class="tpl-shot"
                    src={templatePreview(tpl)}
                    width={PREVIEW.width}
                    height={PREVIEW.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="tpl-badge">{d.work.badge}</span>
                </div>
              </div>
              <div class="mt-5 flex items-center justify-between gap-3">
                <span class="tag">{text.type}</span>
                <span class="tpl-go inline-flex items-center gap-2 text-sm font-medium text-emerald-400">
                  {d.work.view}
                  <Icon name="arrow" size={16} class="arrow" />
                </span>
              </div>
              <h3 class="mt-3 text-xl font-semibold text-white">{text.title}</h3>
              <p class="mt-2 text-muted">{text.blurb}</p>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .tpl-frame { overflow: hidden; padding: 0; transition: transform var(--duration-base) var(--ease-out-expo), box-shadow var(--duration-base) var(--ease-out-expo); }
  .tpl:hover .tpl-frame, .tpl:focus-visible .tpl-frame { transform: translateY(-4px); }
  .tpl:focus-visible { outline: none; }
  .tpl:focus-visible .tpl-frame { outline: 2px solid var(--color-emerald-400); outline-offset: 4px; }
  .tpl-view { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: #f5f5f5; }
  /* The screenshot is much taller than the frame: hovering scrolls through it, like browsing the page */
  .tpl-shot { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; transition: object-position 6s cubic-bezier(0.45, 0, 0.35, 1); }
  .tpl:hover .tpl-shot, .tpl:focus-visible .tpl-shot { object-position: 50% 100%; }
  .tpl-badge {
    position: absolute; inset-block-end: 0.7rem; inset-inline-start: 0.7rem; padding: 0.2rem 0.65rem; border-radius: 999px;
    font-size: 0.75rem; color: var(--color-mist); background: rgb(23 29 41 / 0.88); border: 1px solid rgb(255 255 255 / 0.12);
  }
  :global([dir='rtl']) .tpl-go :global(.arrow) { transform: scaleX(-1); }
  .tpl:hover .tpl-go :global(.arrow) { transform: translateX(4px); }
  :global([dir='rtl']) .tpl:hover .tpl-go :global(.arrow) { transform: scaleX(-1) translateX(4px); }
  @media (prefers-reduced-motion: reduce) { .tpl-shot { transition: none; } .tpl:hover .tpl-shot { object-position: 50% 0%; } }
</style>
