---
import { t, type Locale } from '../i18n';
import SectionHeader from './SectionHeader.astro';
interface Props { locale: Locale }
const d = t(Astro.props.locale);
---
<section id="work" class="relative py-20 md:py-28" aria-labelledby="work-title" data-loop>
  <div class="shell">
    <SectionHeader id="work-title" num="05" kicker={d.work.kicker} title={d.work.title} intro={d.work.intro} />
    <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {d.work.items.map((label, i) => (
        <li data-reveal="item">
          <figure>
            <div class="frame card overflow-hidden p-0" dir="ltr" aria-hidden="true">
              <div class="flex items-center gap-1.5 border-b border-white/8 px-4 py-3">
                <span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span>
                <span class="ms-3 h-5 flex-1 rounded-full bg-white/6"></span>
              </div>
              <div class="relative aspect-[4/3] p-4">
                {i === 0 && (
                  <div class="grid h-full grid-cols-[1fr_1.4fr] gap-3">
                    <div class="space-y-2"><div class="sk h-3 w-3/4"></div><div class="sk h-2 w-1/2"></div><div class="sk mt-4 h-8 w-full rounded-lg"></div><div class="sk h-8 w-full rounded-lg"></div></div>
                    <div class="grid grid-cols-5 gap-1.5 content-start">{Array.from({ length: 20 }).map((_, k) => <div class:list={['sk aspect-square rounded-md', k === 8 && 'sk-accent']}></div>)}</div>
                  </div>
                )}
                {i === 1 && (
                  <div class="grid h-full grid-cols-3 gap-3">{Array.from({ length: 6 }).map((_, k) => <div class="space-y-1.5"><div class:list={['sk aspect-square rounded-lg', k === 1 && 'sk-accent']}></div><div class="sk h-2 w-3/4"></div><div class="sk h-2 w-1/3"></div></div>)}</div>
                )}
                {i === 2 && (
                  <div class="grid h-full grid-rows-[1.6fr_1fr] gap-3">
                    <div class="sk rounded-lg"></div>
                    <div class="grid grid-cols-[1.2fr_1fr] gap-3"><div class="space-y-2"><div class="sk h-3 w-2/3"></div><div class="sk h-2 w-full"></div><div class="sk h-2 w-5/6"></div></div><div class="sk sk-accent rounded-lg"></div></div>
                  </div>
                )}
                <div class="absolute inset-0 grid place-items-center bg-[radial-gradient(circle_at_center,rgb(23_29_41/0.55),transparent_70%)]"></div>
              </div>
            </div>
            <figcaption class="mt-4 flex items-center justify-between gap-3">
              <span class="font-medium text-white">{label}</span>
              <span class="inline-flex items-center gap-2 rounded-full border border-white/12 px-3 py-1 text-xs text-mist"><span class="node scale-75" aria-hidden="true"></span>{d.work.soon}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sk { background: linear-gradient(90deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.11), rgb(255 255 255 / 0.06)); background-size: 200% 100%; border-radius: 4px; animation: sk 2.8s linear infinite; }
  .sk-accent { background: linear-gradient(135deg, rgb(22 171 121 / 0.45), rgb(22 171 121 / 0.15)); animation: none; }
  @keyframes sk { to { background-position: -200% 0; } }
  .frame { transition: transform var(--duration-base) var(--ease-out-expo); }
  figure:hover .frame { transform: translateY(-4px); }
</style>
