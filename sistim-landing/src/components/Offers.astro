---
import { t, type Locale } from '../i18n';
import { SHOW_PRICES, PRICES } from '../config/site';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
interface Props { locale: Locale }
const d = t(Astro.props.locale);
const fmt = (n: number) => new Intl.NumberFormat('fr-FR').format(n); // "7 500"
// Offer -> index of the matching "need" option in the contact form
const needFor: Record<string, number> = { starter: 0, business: 2, saas: 3 };
---
<section id="offers" class="relative py-20 md:py-28" aria-labelledby="offers-title">
  <div class="shell">
    <SectionHeader id="offers-title" num="02" kicker={d.offers.kicker} title={d.offers.title} intro={d.offers.intro} />
    <ul class="mt-14 grid gap-5 lg:grid-cols-3">
      {d.offers.items.map((o) => {
        const featured = o.id === 'business';
        return (
          <li class:list={['card card-glow relative flex flex-col p-7 md:p-8', featured && 'offer-featured lg:-translate-y-3']} data-reveal="item">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-2xl font-semibold text-white">{o.name}</h3>
              {o.badge && <span class="tag shrink-0">{o.badge}</span>}
            </div>
            <p class="mt-2 text-muted">{o.for}</p>

            <div class="mt-7 min-h-[5.5rem] border-y border-white/8 py-5">
              {SHOW_PRICES ? (
                <div class="space-y-1.5">
                  {o.prices.map((p) => (
                    <p class="flex flex-wrap items-baseline gap-x-2">
                      <span class="text-sm text-muted">{p.label ? `${p.label} · ` : ''}{d.offers.from}</span>
                      <span class="text-3xl font-semibold text-white"><span class="ltr">{fmt(PRICES[p.key as keyof typeof PRICES])}</span> <span class="text-base font-medium text-emerald-400">{d.offers.currency}</span></span>
                    </p>
                  ))}
                </div>
              ) : (
                <p class="text-2xl font-semibold text-white">{d.offers.onQuote}</p>
              )}
            </div>

            <ul class="mt-6 flex-1 space-y-3">
              {o.features.map((f) => (
                <li class="flex gap-3 text-white/90">
                  <Icon name="check" size={18} class="mt-[0.3em] shrink-0 text-emerald-400" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <p class="mt-7 flex items-center justify-between gap-3 text-sm">
              <span class="text-muted">{d.offers.timelineLabel}</span>
              <span class="font-medium text-mist">{o.timeline}</span>
            </p>
            <a href="#contact" data-need={needFor[o.id]} class:list={['btn mt-6 w-full', featured ? 'btn-primary' : 'btn-ghost']}>
              <span>{d.offers.quote}</span>
              <Icon name="arrow" size={18} class="arrow" />
            </a>
          </li>
        );
      })}
    </ul>
    <p class="mt-8 flex items-center gap-3 text-sm text-muted" data-reveal="item">
      <span class="node" aria-hidden="true"></span>
      {SHOW_PRICES ? d.offers.noteShown : d.offers.noteHidden}
    </p>
  </div>
</section>

<style>
  .offer-featured {
    background: linear-gradient(180deg, #29434e, var(--color-navy-800) 45%) padding-box,
      linear-gradient(160deg, rgb(60 203 152 / 0.9), rgb(22 171 121 / 0.25) 45%, rgb(255 255 255 / 0.08)) border-box;
  }
</style>
