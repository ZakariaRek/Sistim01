---
// Entry page "/". With JavaScript it forwards the visitor to /ar/, /fr/ or /en/:
//   1. a language chosen earlier with the switcher (localStorage "sistim-lang") always wins,
//   2. otherwise the first of navigator.languages whose primary subtag is ar, fr or en,
//   3. otherwise English.
// location.replace() keeps "/" out of the history, so Back never loops.
// Without JavaScript (and for crawlers) it is a small branded language chooser with real links.
import '../styles/global.css';
import { LOCALES, LOCALE_META, t } from '../i18n';
import { SITE_URL, BRAND_NAME } from '../config/site';

const description = `${t('en').meta.description} · ${t('fr').meta.description}`;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      (function () {
        var pick = null;
        try {
          var saved = localStorage.getItem('sistim-lang');
          if (saved === 'ar' || saved === 'fr' || saved === 'en') pick = saved;
        } catch (e) {}
        if (!pick) {
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          for (var i = 0; i < langs.length; i++) {
            var primary = String(langs[i]).toLowerCase().split('-')[0];
            if (primary === 'ar' || primary === 'fr' || primary === 'en') { pick = primary; break; }
          }
        }
        document.documentElement.style.visibility = 'hidden';
        location.replace('/' + (pick || 'en') + '/' + location.search + location.hash);
      })();
    </script>
    <title>Sistim · سيستيم</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${SITE_URL}/`} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={LOCALE_META[l].lang} href={`${SITE_URL}${LOCALE_META[l].path}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />
    <meta name="theme-color" content="#232B3B" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:title" content="Sistim · سيستيم" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${SITE_URL}/`} />
    <meta property="og:image" content={`${SITE_URL}/og/og-en.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="grid min-h-[100svh] place-items-center bg-navy-900 bg-[radial-gradient(900px_600px_at_50%_20%,rgb(22_171_121/0.12),transparent_60%)] px-4 py-16 text-white">
    <main class="w-full max-w-md text-center">
      <picture>
        <source type="image/avif" srcset="/brand/wordmark-circuit-480.avif 1x, /brand/wordmark-circuit-960.avif 2x" />
        <source type="image/webp" srcset="/brand/wordmark-circuit-480.webp 1x, /brand/wordmark-circuit-960.webp 2x" />
        <img src="/brand/wordmark-circuit-480.png" width="240" height="122" alt={BRAND_NAME} class="mx-auto h-auto w-60" />
      </picture>
      <h1 class="mt-10 space-y-1 text-lg font-medium text-muted">
        {LOCALES.map((l) => <span class="block" lang={LOCALE_META[l].lang} dir={LOCALE_META[l].dir}>{t(l).entry.choose}</span>)}
      </h1>
      <ul class="mt-8 grid gap-3">
        {LOCALES.map((l) => (
          <li>
            <a
              href={LOCALE_META[l].path}
              hreflang={LOCALE_META[l].lang}
              lang={LOCALE_META[l].lang}
              dir={LOCALE_META[l].dir}
              data-lang-link={l}
              class="card flex min-h-16 items-center justify-between gap-4 px-6 text-xl font-medium text-white transition-colors hover:bg-navy-800"
            >
              <span>{LOCALE_META[l].native}</span>
              <span class="font-mono text-xs text-emerald-400" dir="ltr">{LOCALE_META[l].short}</span>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <script is:inline>
      document.querySelectorAll('[data-lang-link]').forEach(function (a) {
        a.addEventListener('click', function () { try { localStorage.setItem('sistim-lang', a.getAttribute('data-lang-link')); } catch (e) {} });
      });
    </script>
  </body>
</html>
