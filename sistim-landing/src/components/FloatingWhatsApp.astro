---
import { t, type Locale } from '../i18n';
import { whatsappHref } from '../config/contact';
import Icon from './Icon.astro';
interface Props { locale: Locale }
const d = t(Astro.props.locale);
---
<a
  href={whatsappHref()}
  target="_blank"
  rel="noopener"
  class="float-wa fixed bottom-[max(1rem,env(safe-area-inset-bottom))] end-4 z-50 grid size-14 place-items-center rounded-full bg-emerald-500 text-navy-950 shadow-[0_12px_32px_-8px_rgb(22_171_121/0.8)] md:hidden"
  aria-label={`${d.a11y.whatsappFloat} ${d.a11y.newTab}`}
>
  <Icon name="whatsapp" size={26} />
</a>
<style>
  :global(html.menu-open) .float-wa { display: none; }
</style>
