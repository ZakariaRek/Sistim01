---
// Template viewer: /ar/templates/dentist/ ... The template runs in a full-height frame you can scroll,
// with a desktop / mobile size switch. Header: back to the templates, the demo's name, open in a new tab,
// and the free-consultation button (same wording and destination as everywhere else).
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import LangSwitcher from '../../../components/LangSwitcher.astro';
import { LOCALES, localePath, t, fill, type Locale } from '../../../i18n';
import { TEMPLATES, templateFile } from '../../../config/templates';

export const getStaticPaths = () => LOCALES.flatMap((lang) => TEMPLATES.map((tpl) => ({ params: { lang, slug: tpl.slug } })));
const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const d = t(lang);
const tpl = TEMPLATES.find((x) => x.slug === slug)!;
const text = d.work.items[tpl.slug as keyof typeof d.work.items];
const v = d.work.viewer;
const src = templateFile(tpl);
const back = `${localePath(lang)}#work`;
const consult = `${localePath(lang, 'consultation')}?need=${tpl.need}`;
---
<Base
  locale={lang}
  page={`templates/${slug}`}
  title={fill(v.metaTitle, { title: text.title })}
  description={fill(v.metaDescription, { blurb: text.blurb })}
  robots="noindex,follow"
>
  <div class="viewer" data-device="desktop" data-back={back}>
    <header class="viewer-bar">
      <a href={back} class="viewer-back" aria-label={v.back}>
        <Icon name="arrow" size={18} class="viewer-back-arrow" />
        <span class="hidden sm:inline">{v.back}</span>
      </a>

      <div class="min-w-0 flex-1 px-2 text-center">
        <p class="truncate text-[0.95rem] font-semibold leading-tight text-white">{text.title}</p>
        <p class="hidden truncate text-xs text-muted md:block">{v.note}</p>
      </div>

      <div class="flex items-center gap-2">
        <div class="viewer-devices hidden sm:flex" role="group" aria-label={v.device}>
          <button type="button" data-set-device="desktop" aria-pressed="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18v11H3z M8 20h8 M12 16v4" /></svg>
            <span class="hidden lg:inline">{v.desktop}</span><span class="sr-only lg:hidden">{v.desktop}</span>
          </button>
          <button type="button" data-set-device="mobile" aria-pressed="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h10v18H7z M11 18h2" /></svg>
            <span class="hidden lg:inline">{v.mobile}</span><span class="sr-only lg:hidden">{v.mobile}</span>
          </button>
        </div>
        <a href={src} target="_blank" rel="noopener" class="viewer-icon" title={v.openNew}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6 M20 4l-9 9 M18 14v5H5V6h5" /></svg>
          <span class="sr-only">{v.openNew} {d.a11y.newTab}</span>
        </a>
        <LangSwitcher locale={lang} page={`templates/${slug}`} class="hidden xl:block" />
        <a href={consult} class="btn btn-primary min-h-11 px-4 text-sm">{d.consult.cta}</a>
      </div>
    </header>

    <main id="main" tabindex="-1" class="viewer-stage outline-none">
      <div class="viewer-loading" role="status">
        <span class="viewer-spinner" aria-hidden="true"></span>
        <span>{v.loading}</span>
      </div>
      <div class="viewer-device">
        <iframe src={src} title={fill(v.frameTitle, { title: text.title })} class="viewer-frame" loading="eager"></iframe>
      </div>
    </main>
  </div>
</Base>

<style is:global>
  html:has(.viewer), body:has(.viewer) { height: 100%; overflow: hidden; }
</style>
<style>
  .viewer { display: grid; grid-template-rows: auto minmax(0, 1fr); height: 100svh; background: var(--color-navy-950); }
  .viewer-bar {
    display: flex; align-items: center; gap: 0.5rem; min-height: 3.75rem; padding: max(env(safe-area-inset-top), 0.5rem) 0.75rem 0.5rem;
    background: rgb(35 43 59 / 0.96); border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  @media (min-width: 768px) { .viewer-bar { padding-inline: 1.25rem; gap: 0.75rem; } }
  .viewer-back, .viewer-icon {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 2.75rem; min-width: 2.75rem; padding-inline: 0.75rem;
    border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.14); color: var(--color-white); font-size: 0.9rem;
    transition: background-color var(--duration-fast) var(--ease-out-expo), border-color var(--duration-fast) var(--ease-out-expo);
  }
  .viewer-back:hover, .viewer-icon:hover { background: rgb(255 255 255 / 0.06); border-color: rgb(255 255 255 / 0.28); }
  .viewer-back :global(.viewer-back-arrow) { transform: scaleX(-1); } /* points back: left in LTR */
  :global([dir='rtl']) .viewer-back :global(.viewer-back-arrow) { transform: none; }

  .viewer-devices { padding: 0.25rem; gap: 0.125rem; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.1); background: rgb(23 29 41 / 0.6); }
  .viewer-devices button {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.5rem; padding-inline: 0.85rem; border-radius: 999px; font-size: 0.85rem;
    color: var(--color-muted); transition: background-color var(--duration-fast) var(--ease-out-expo), color var(--duration-fast) var(--ease-out-expo);
  }
  .viewer-devices button:hover { color: var(--color-white); }
  .viewer-devices button[aria-pressed='true'] { background: var(--color-emerald-500); color: var(--color-navy-950); }

  .viewer-stage {
    position: relative; min-height: 0; overflow: hidden;
    background: radial-gradient(900px 500px at 50% 0%, rgb(22 171 121 / 0.1), transparent 70%), var(--color-navy-950);
  }
  .viewer-stage::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0.05; background: url('/grain.png'); background-size: 160px; }
  .viewer-device { position: absolute; inset: 0; margin-inline: auto; transition: width 0.5s var(--ease-out-expo), inset 0.5s var(--ease-out-expo), border-radius 0.5s var(--ease-out-expo); }
  .viewer-frame { display: block; width: 100%; height: 100%; border: 0; background: #fff; opacity: 0; transition: opacity 0.4s var(--ease-out-expo); }
  .viewer[data-loaded] .viewer-frame { opacity: 1; }

  /* phone size: a centred device with a bezel */
  .viewer[data-device='mobile'] .viewer-device {
    inset: 1rem 0; width: min(390px, calc(100% - 2rem)); border-radius: 2.25rem; overflow: hidden;
    border: 10px solid var(--color-navy-700); box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.7);
  }
  @media (max-width: 639px) { .viewer[data-device='mobile'] .viewer-device { inset: 0; width: 100%; border: 0; border-radius: 0; } }

  .viewer-loading { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 0.9rem; color: var(--color-muted); font-size: 0.95rem; transition: opacity 0.3s; }
  .viewer[data-loaded] .viewer-loading { opacity: 0; visibility: hidden; }
  .viewer-spinner { width: 2rem; height: 2rem; border-radius: 999px; border: 2px solid rgb(255 255 255 / 0.15); border-top-color: var(--color-emerald-400); animation: viewer-spin 0.9s linear infinite; }
  @keyframes viewer-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .viewer-spinner { animation-duration: 3s; } .viewer-device, .viewer-frame { transition: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.viewer')!;
  const frame = root.querySelector<HTMLIFrameElement>('.viewer-frame')!;

  // size switch (desktop / mobile)
  root.querySelectorAll<HTMLButtonElement>('[data-set-device]').forEach((btn) =>
    btn.addEventListener('click', () => {
      root.dataset.device = btn.dataset.setDevice!;
      root.querySelectorAll('[data-set-device]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    }),
  );

  // once the demo has loaded: fade it in, and send external links (WhatsApp, Instagram, Maps) to a new tab,
  // because those sites refuse to be shown inside a frame
  let revealed = false;
  const reveal = () => { revealed = true; root.dataset.loaded = 'true'; };
  const onLoad = () => {
    try {
      const doc = frame.contentDocument;
      if (!doc) { reveal(); return; }
      // show the demo once its fonts are in (or after 2.5 s), so it never reflows in front of the visitor
      Promise.race([doc.fonts?.ready ?? Promise.resolve(), new Promise((r) => setTimeout(r, 2500))]).then(() => setTimeout(reveal, 150));
      doc.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
        if (!a) return;
        const url = new URL(a.href, doc.baseURI);
        if (url.origin !== location.origin) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
      }, true);
    } catch { reveal(); /* cross-origin frame: nothing to do */ }
  };
  frame.addEventListener('load', onLoad);
  if (frame.contentDocument?.readyState === 'complete' && frame.contentDocument.body?.childElementCount) onLoad();
  setTimeout(() => { if (!revealed) reveal(); }, 6000); // never leave the spinner up forever

  // Esc: back to the templates
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') location.href = root.dataset.back!; });
  import('../../../scripts/common');
</script>
